{
  "name": "botcamp",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed.mjs",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "npm run dev --prefix web",
    "dev": "npm run seed && concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm run build --prefix web",
    "start": "npm run seed && NODE_ENV=production node server/index.mjs",
    "test:isolation": "node scripts/isolation-check.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
