# Copy to ~/.botcamp/relay.env (chmod 600). The agent loads it at start.
BOTCAMP_GATEWAY=https://camp.aigc.sx.cn
BOTCAMP_SSH_HOST=root@server.example.com
BOTCAMP_SSH_KEY=/path/to/id_ed25519
BOTCAMP_HOST_PORT=8765
BOTCAMP_REMOTE_PORT_BASE=18765

# Issued by the gateway at pairing time (long-lived inference key).
BOTCAMP_LLM_KEY=bc-...
