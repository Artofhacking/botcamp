@@ -0,0 +1,182 @@
+import { mkdtempSync, mkdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { CHIEF_LEDGER_URL } from '../src/chief/contract.ts'
+import { createElectronChiefBrowser } from '../src/chief/electron-browser.ts'
+import { postLedger } from '../src/chief/ledger.ts'
+import { hostAllowed } from '../src/chief/policy.ts'
+import { createChiefService, type ChiefBrowser } from '../src/chief/service.ts'
+import { sendChiefTurn, transcriptFromLedger, ChiefTurnError } from '../src/chief/turn.ts'
+import { readWorkspace } from '../src/chief/workspace.ts'
+
+function fakeBrowser(): ChiefBrowser & { calls: Array<{ url: string; hosts: readonly string[] }> } {
+  const calls: Array<{ url: string; hosts: readonly string[] }> = []
+  return {
+    calls,
+    async open(url, hosts) {
+      calls.push({ url, hosts })
+      return hostAllowed(url, hosts) ? '打开了页面' : '没有打开。这个地址不属于当前用户自己的账号站点。'
+    },
+    async read() { return '当前页' },
+    close() {},
+  }
+}
+
+describe('主编 ledger and desktop tools', () => {
+  it('allows only the signed-in site over https', () => {
+    expect(hostAllowed('https://www.xiaoheihe.cn/creator', ['xiaoheihe.cn'])).toBe(true)
+    expect(hostAllowed('http://www.xiaoheihe.cn/', ['xiaoheihe.cn'])).toBe(false)
+    expect(hostAllowed('https://evil.example/', ['xiaoheihe.cn'])).toBe(false)
+    expect(hostAllowed('https://127.0.0.1/', ['127.0.0.1'])).toBe(false)
+  })
+
+  it('posts 主编 chat to the shared ledger and refuses other endpoints', async () => {
+    const seen: Array<{ url: string; body: string; authorization: string | null }> = []
+    const fetchImpl: typeof fetch = async (input, init) => {
+      const headers = new Headers(init?.headers)
+      seen.push({
+        url: String(input),
+        body: String(init?.body),
+        authorization: headers.get('authorization'),
+      })
+      return new Response(JSON.stringify({ ok: true, value: { items: [{ kind: 'user', text: '还在' }] } }), { status: 200 })
+    }
+    const result = await postLedger('chat', { sessionId: 'other', botId: 'other' }, '', fetchImpl)
+    expect(seen[0]?.url).toBe(CHIEF_LEDGER_URL)
+    expect(seen[0]?.body).toContain('"sessionId":"co_chief"')
+    expect(seen[0]?.body).not.toContain('other')
+    expect(seen[0]?.authorization).toBeNull()
+    expect(result.data.value?.items).toEqual([{ kind: 'user', text: '还在' }])
+    await expect(postLedger('delete', {}, '', fetchImpl)).rejects.toThrow('没有这个接口。')
+    expect(seen).toHaveLength(1)
+  })
+
+  it('hides a token when the ledger cannot be reached', async () => {
+    const sample = 'sample-session-token'
+    const fetchImpl: typeof fetch = async () => { throw new Error(`down ${sample}`) }
+    const service = createChiefService({ browser: fakeBrowser(), userDataDir: '/tmp/unused', fetchImpl })
+    await expect(service.handle({ op: 'ledger', endpoint: 'chat', payload: {}, token: sample }))
+      .rejects.toThrow('账本暂时没有连上。')
+    try {
+      await service.handle({ op: 'ledger', endpoint: 'send', payload: { text: '你好' }, token: sample })
+    } catch (error) {
+      expect(error instanceof Error && error.message.includes(sample)).toBe(false)
+    }
+  })
+
+  it('keeps the visible transcript when a refresh does not return items', () => {
+    const previous = [{ kind: 'user' as const, text: '还在' }]
+    expect(transcriptFromLedger(previous, { status: 500, data: {} })).toEqual(previous)
+    expect(transcriptFromLedger(previous, { status: 401, data: {} })).toEqual(previous)
+    expect(transcriptFromLedger(previous, {
+      status: 200,
+      data: { value: { items: [{ kind: 'user', text: '还在' }, { kind: 'bot', text: '我是主编。' }] } },
+    })).toEqual([
+      { kind: 'user', text: '还在' },
+      { kind: 'bot', text: '我是主编。' },
+    ])
+  })
+
+  it('runs a desktop tool and then asks for a reply without clearing the send', async () => {
+    const calls: Record<string, unknown>[] = []
+    await sendChiefTurn({
+      text: '看看后台',
+      ledger: async payload => {
+        calls.push(payload)
+        if (calls.length === 1) {
+          return {
+            status: 200,
+            data: { ok: true, value: { tool: { tool: 'browser_open', url: 'https://www.xiaoheihe.cn/', hosts: ['xiaoheihe.cn'] } } },
+          }
+        }
+        return { status: 200, data: { ok: true, value: {} } }
+      },
+      runTool: async () => '页面 后台',
+    })
+    expect(calls[0]).toMatchObject({ desktop: true, text: '看看后台', sessionId: 'co_chief' })
+    expect(calls[0]).not.toHaveProperty('resume')
+    expect(calls[1]).toMatchObject({ resume: true, desktop: true, toolResult: { text: '页面 后台' } })
+  })
+
+  it('leaves a failed model send marked on the ledger instead of dropping it', async () => {
+    let calls = 0
+    await expect(sendChiefTurn({
+      text: '用一句话介绍你自己',
+      ledger: async () => {
+        calls += 1
+        return { status: 200, data: { ok: false, error: { message: '模型这次没有答上来。' } } }
+      },
+      runTool: async () => 'unused',
+    })).rejects.toBeInstanceOf(ChiefTurnError)
+    expect(calls).toBe(1)
+  })
+
+  it('reads only files inside the chosen workspace', async () => {
+    const parent = mkdtempSync(join(tmpdir(), 'dsh-chief-'))
+    const root = join(parent, 'work')
+    const userData = join(parent, 'user')
+    try {
+      mkdirSync(root)
+      mkdirSync(userData)
+      writeFileSync(join(root, '标题.md'), '正文')
+      writeFileSync(join(parent, 'secret.txt'), 'outside-marker')
+      symlinkSync(join(parent, 'secret.txt'), join(root, 'link.txt'))
+      const service = createChiefService({ browser: fakeBrowser(), userDataDir: userData })
+      const chosen = await service.handle({ op: 'computer_choose', root })
+      expect(chosen).toBe(root)
+      const listing = await service.handle({ op: 'computer_list' })
+      expect(listing).toContain('标题.md')
+      expect(listing).not.toContain('secret.txt')
+      expect(listing).not.toContain('link.txt')
+      expect(await service.handle({ op: 'computer_read', path: '标题.md' })).toBe('正文')
+      const escaped = await service.handle({ op: 'computer_read', path: '../secret.txt' })
+      expect(escaped).toBe('没有这份文件。')
+      expect(String(escaped)).not.toContain('outside-marker')
+      expect(readWorkspace(userData, 'link.txt')).not.toContain('outside-marker')
+    } finally {
+      rmSync(parent, { recursive: true, force: true })
+    }
+  })
+
+  it('opens an allowed page in the desktop browser and blocks any other host', async () => {
+    const loads: string[] = []
+    const guards: Array<(event: { preventDefault(): void }, url: string) => void> = []
+    class FakeWindow {
+      destroyed = false
+      shown = false
+      webContents = {
+        setWindowOpenHandler() {},
+        on(name: string, listener: (event: { preventDefault(): void }, url: string) => void) {
+          if (name === 'will-navigate') guards.push(listener)
+        },
+        async executeJavaScript() {
+          return { title: '后台', url: 'https://www.xiaoheihe.cn/', text: '可见正文' }
+        },
+      }
+      constructor(_options: object) {}
+      isDestroyed(): boolean { return this.destroyed }
+      setTitle(): void {}
+      show(): void { this.shown = true }
+      destroy(): void { this.destroyed = true }
+      async loadURL(url: string): Promise<void> { loads.push(url) }
+    }
+    const browser = createElectronChiefBrowser({
+      BrowserWindow: FakeWindow as unknown as new (options: object) => FakeWindow,
+    })
+    const opened = await browser.open('https://www.xiaoheihe.cn/creator', ['xiaoheihe.cn'])
+    expect(opened).toContain('可见正文')
+    expect(loads).toEqual(['https://www.xiaoheihe.cn/creator'])
+    const blocked = await browser.open('https://evil.example/phish', ['xiaoheihe.cn'])
+    expect(blocked).toContain('没有打开')
+    expect(loads).toEqual(['https://www.xiaoheihe.cn/creator'])
+    const guard = guards[0]
+    expect(guard).toEqual(expect.any(Function))
+    let prevented = false
+    guard?.({ preventDefault() { prevented = true } }, 'https://evil.example/')
+    expect(prevented).toBe(true)
+    prevented = false
+    guard?.({ preventDefault() { prevented = true } }, 'https://www.xiaoheihe.cn/next')
+    expect(prevented).toBe(false)
+  })
+})
