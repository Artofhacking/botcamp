# Source-checkout placeholders. Copy to .env and replace the empty secrets.
# Blank means unset.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=
# Routes private computers' TCP through the desktop app that has the switch on; 0 turns it off.
COMPUTER_RELAY_PORT=1080
SANDBOX_SUPERVISOR_TOKEN=
SANDBOX_PROVIDER=docker
SANDBOX_COMPUTER_EGRESS=
BOTCAMP_COMPUTER_MEMORY=
BOTCAMP_COMPUTER_CPUS=
BOTCAMP_COMPUTER_PIDS_LIMIT=
OPENROUTER_API_KEY=

# API host deploy credential, read by the release runbook in docs/ci.md.
# Fill these in a local .env (gitignored); never commit them.
BOTCAMP_DEPLOY_HOST=
BOTCAMP_DEPLOY_USER=
BOTCAMP_DEPLOY_PORT=
BOTCAMP_DEPLOY_PASSWORD=
